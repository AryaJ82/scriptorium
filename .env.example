DATABASE_URL="file:./prisma/dev.db"

# Generate distinct random values for each secret before using authentication.
JWT_ACCESS_SECRET="replace-with-a-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret"

# Optional API origin. Leave empty to use this app's origin.
NEXT_PUBLIC_API_URL=""

# Optional settings. Defaults are shown in comments.
# SALT_ROUNDS=10
# ACCESS_TOKEN_EXPIRY=10
# REFRESH_TOKEN_EXPIRY=4
# EXECUTION_TIMELIMIT_MS=10000
# MEMORY_LIMIT_MB=128
# CPU_LIMIT=0.5
# MAX_CODE_SIZE_KB=64
# MAX_STDIN_SIZE_KB=64
# MAX_OUTPUT_SIZE_KB=64
